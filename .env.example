# ==============================================================================
# Nigrani AI - Intelligent Surveillance Environment Configuration
# ==============================================================================

# Server Configuration
API_PORT=8000
API_HOST=0.0.0.0
ENVIRONMENT=production
LOGGING_LEVEL=INFO

# Frontend Integration (CORS)
# Set this to your frontend URL (e.g. http://localhost:5173 or https://nigrani.yourdomain.com)
FRONTEND_URL=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Video Pipeline Performance Settings
FRAME_QUEUE_SIZE=30
PROCESS_FPS=10

# YOLO Configuration
# In Docker: /app/yolo11n.pt, or local path: yolo11n.pt
YOLO_MODEL=yolo11n.pt
YOLO_CONFIDENCE=0.40
YOLO_IOU=0.45
# Set to 'cpu' for standard CPU Docker deployment or 'cuda' if GPU runtime is enabled
YOLO_DEVICE=cpu
DETECTION_CLASSES=person,car,motorcycle,bus,truck

# Tracker Configuration (ByteTrack)
TRACKER_TYPE=bytetrack
TRACKER_TRACK_BUFFER=30
TRACKER_MATCH_THRESHOLD=0.80
TRACK_HISTORY_LENGTH=30

# Virtual Fence Configuration
VIRTUAL_FENCE_ENABLED=true
TRIGGER_ON_INITIAL_INSIDE=false
FENCE_POINT_STRATEGY=bottom_center
FENCE_MONITORED_CLASSES=person,car,motorcycle,bus,truck
INTRUSION_CONFIRMATION_FRAMES=2
FENCE_BOUNDARY_TOLERANCE=5
INTRUSION_COOLDOWN=60

# ANPR (Automatic Number Plate Recognition) Configuration
ANPR_ENABLED=true
ANPR_PROCESS_INTERVAL=2
ANPR_MIN_CONFIDENCE=0.60

# Face Recognition Configuration
FACE_RECOGNITION_ENABLED=true

# Behavior Engine Configuration
LOITERING_ENABLED=true
LOITERING_TIME_THRESHOLD=5
LOITERING_DISTANCE_THRESHOLD=50
LOITERING_COOLDOWN=60

NIGHT_MOVEMENT_ENABLED=true
NIGHT_MOVEMENT_MODE=AUTO
NIGHT_START_TIME=18:00
NIGHT_END_TIME=06:00
NIGHT_MOVEMENT_MIN_DISTANCE=20
NIGHT_MOVEMENT_MIN_DURATION=2
NIGHT_MOVEMENT_COOLDOWN=30

# Correlation Engine Configuration
CORRELATION_ENABLED=true
CORRELATION_TIME_WINDOW_SECONDS=300
CORRELATION_CAMERA_DISTANCE_METERS=1000
MIN_INCIDENT_CORRELATION_SCORE=60

# Event and Alert Storage Thresholds
ALERT_COOLDOWN_SECONDS=60
MAX_IN_MEMORY_EVENTS=1000
MAX_IN_MEMORY_ALERTS=500
